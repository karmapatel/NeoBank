# ==============================================================================
# NeoBank Supabase & Application Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your Supabase project credentials.
#
# Where to find these in your Supabase Dashboard:
# 1. Go to https://app.supabase.com
# 2. Select your Project
# 3. For Database URI:
#    Go to "Project Settings" (gear icon) -> "Database" -> "Connection string"
#    Choose "URI" (Mode: Transaction or Session for Pooler, or Direct).
#    Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#    or Pooler: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# 4. For API Keys (Optional if using Supabase Python SDK for Auth/Storage):
#    Go to "Project Settings" -> "API"
#    Copy "Project URL" and "anon public" or "service_role" API key.
# ==============================================================================

# --- Option A: Full Supabase Database URI (Recommended) ---
# Paste your Supabase PostgreSQL connection string below:
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- Option B: Discrete Parameters (Alternative to Option A) ---
# If your password has special characters like @, #, %, you can set these instead:
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=your-super-secret-password
# SUPABASE_DB_HOST=db.[PROJECT-REF].supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres

# --- Supabase API Client (Optional for Supabase Auth / Storage / Realtime) ---
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_KEY=your-supabase-anon-or-service-key

# --- Flask App Settings ---
SECRET_KEY=neobank-ultra-secure-key-9284729184
FLASK_DEBUG=True
